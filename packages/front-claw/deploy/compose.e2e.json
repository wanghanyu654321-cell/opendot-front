{
  "name": "front-dot",
  "services": {
    "pg": {
      "image": "postgres:17.6-bookworm",
      "environment": {
        "POSTGRES_DB": "synthetic",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "${PG_ADMIN_PASSWORD:?required}"
      },
      "command": [
        "postgres",
        "-c",
        "shared_buffers=128MB",
        "-c",
        "work_mem=4MB",
        "-c",
        "maintenance_work_mem=64MB",
        "-c",
        "max_connections=30",
        "-c",
        "wal_keep_size=64MB"
      ],
      "volumes": [
        "pgdata:/var/lib/postgresql/data"
      ],
      "networks": [
        "private"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres -d synthetic"
        ],
        "interval": "2s",
        "timeout": "3s",
        "retries": 30
      },
      "mem_limit": "512m",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "restart": "unless-stopped"
    },
    "core": {
      "image": "front-dot:${FRONT_DOT_SHA:?required}",
      "build": {
        "context": "..",
        "dockerfile": "deploy/Dockerfile"
      },
      "environment": {
        "AUDIT_PG_ALLOW": "isolated-synthetic",
        "FRONT_DOT_CHANNEL": "offline",
        "FRONT_DOT_BIND": "0.0.0.0",
        "FRONT_CLAW_DATABASE_URL": "${APP_DATABASE_URL:?required}"
      },
      "depends_on": {
        "pg": {
          "condition": "service_healthy"
        }
      },
      "networks": [
        "private"
      ],
      "deploy": {
        "replicas": 1
      },
      "init": true,
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "3s",
        "timeout": "5s",
        "retries": 20
      },
      "stop_grace_period": "30s",
      "mem_limit": "384m",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp"
      ]
    },
    "driver": {
      "image": "front-dot:${FRONT_DOT_SHA:?required}",
      "profiles": [
        "tools"
      ],
      "environment": {
        "AUDIT_PG_ALLOW": "isolated-synthetic",
        "DATABASE_ADMIN_URL": "${DATABASE_ADMIN_URL:?required}",
        "APP_DATABASE_URL": "${APP_DATABASE_URL:?required}",
        "READONLY_DATABASE_URL": "${READONLY_DATABASE_URL:?required}",
        "APP_DB_PASSWORD": "${APP_DB_PASSWORD:?required}",
        "READONLY_DB_PASSWORD": "${READONLY_DB_PASSWORD:?required}",
        "CORE_URL": "http://core:8080",
        "E2E_ARTIFACT_DIR": "/artifacts"
      },
      "networks": [
        "private"
      ],
      "volumes": [
        "artifacts:/artifacts"
      ],
      "user": "0:0",
      "entrypoint": [
        "node",
        "scripts/e2e/steps.mjs"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "read_only": true,
      "tmpfs": [
        "/tmp"
      ]
    }
  },
  "networks": {
    "private": {
      "internal": true
    }
  },
  "volumes": {
    "pgdata": {},
    "artifacts": {}
  }
}
