# 管理运维工具配置（保存至仓库外安全目录并 chmod 600；绝不注入 core 容器，绝不放 BOT_SECRET）
PG_ADMIN_PASSWORD=replace-with-strong-pg-admin-password
DATABASE_ADMIN_URL=postgres://postgres:replace-with-strong-pg-admin-password@pg:5432/front_dot
APP_DB_PASSWORD=replace-with-strong-app-db-password
READONLY_DB_PASSWORD=replace-with-strong-readonly-db-password

# 机器人标识需与核心配置一致，仅用于白名单试点绑定校验
FRONT_CLAW_WECOM_BOT_ID=replace-with-wecom-bot-id

# seed-pilot 首个试点员工初始化参数
PILOT_MEMBER_ID=replace-with-member-id
PILOT_CORP_ID=replace-with-corp-id
PILOT_DISPLAY_NAME=示例店长
PILOT_STORE_ID=store-01
PILOT_STORE_NAME=示例1店
PILOT_ROLE=manager
