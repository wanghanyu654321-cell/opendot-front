# 核心容器运行配置（保存至仓库外安全目录并 chmod 600，绝不放入 PG 管理账号口令）
FRONT_CLAW_WECOM_ENABLED=1
FRONT_CLAW_WECOM_BOT_ID=replace-with-wecom-bot-id
FRONT_CLAW_WECOM_BOT_SECRET=replace-with-wecom-bot-secret
FRONT_CLAW_WECOM_WORKSPACE_JID=web:wecom-front-claw
FRONT_CLAW_WECOM_INPROCESS_SANDBOX=1
# 可选：指定受控工作区归属的 OpenDot 活跃用户 ID（默认自动选择首个活跃 admin）
# FRONT_CLAW_WECOM_OWNER_USER_ID=

# 可选：P2 全岗位软路由与托管 Skills 开关
# - FRONT_CLAW_WECOM_AUTO_ROLE_GRANT=1（默认 1）：企微已绑定在职员工首次发言时自动按 tier 开通本店店务与四类软岗位权限（已撤权/停用成员绝不自动复活）
# - FRONT_CLAW_WECOM_ENABLED_ROLES（默认 marketing,training,manager_ops,reception_ads 四岗全开）
# - FRONT_CLAW_WECOM_ROLE_SKILLS_ENABLED=1（默认 1）：按软岗位自动校验并挂载 7 个净版托管 Skills（3 营销 / 1 培训 / 1 店长复盘 / 2 接待投流）；设为 0 可一键回退禁用
# FRONT_CLAW_WECOM_AUTO_ROLE_GRANT=1
# FRONT_CLAW_WECOM_ENABLED_ROLES=marketing,training,manager_ops,reception_ads
# FRONT_CLAW_WECOM_ROLE_SKILLS_ENABLED=1

# 可选（兼容 P1 单 Skill 覆盖）：显式配置时仅覆盖 marketing 岗为单一受控 Skill（如 beauty-local-content），设为空串则禁用 marketing 岗 Skills
# FRONT_CLAW_WECOM_MARKETING_SKILL_ID=beauty-local-content

# PG 17 最小权限应用连接串（R2/D46 约束：NODE_ENV=production 严禁使用裸 FRONT_CLAW_DATABASE_URL）
# 请在宿主机仓库外创建只读凭据文件（内容为 postgres://front_app:<url-encoded-app-password>@pg:5432/front_dot）：
#   - .env.admin 中 APP_DB_PASSWORD / READONLY_DB_PASSWORD 均至少 24 位（provision.ts 校验）
#   - 宿主机文件权限与属主：chmod 600 <file> && chown 1000:1000 <file>（UID 1000 对应容器内 id -u node）
#   - Docker Compose 通过 FRONT_CLAW_DB_URL_FILE 环境变量只读（:ro）挂载到 /run/secrets/front_claw_db_url
FRONT_CLAW_DATABASE_URL_FILE=/run/secrets/front_claw_db_url

# M06 主动通知外发开关：首次联调建议先设为 0，核验通过后再切为 1
FRONT_CLAW_NOTIFY_DISPATCH=0

# OpenDot Web 会话密钥（生产请设为 32+ 字节随机串）
WEB_SESSION_SECRET=replace-with-random-32-plus-byte-secret

# 前置意图分类器模型配置（可选 live 模式；默认 stub 保底追问）
# live 模式读取 FC_MODEL_ENDPOINT 与 OpenDot Provider 的 ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY / ANTHROPIC_MODEL（Anthropic /v1/messages）
FC_MODEL_MODE=stub
# FC_MODEL_ENDPOINT=https://api.anthropic.com
# FC_MODEL_TIMEOUT_MS=2500
# 可选：独立指定前置意图分类器模型名（留空时复用 ANTHROPIC_MODEL）
# FC_MODEL_CLASSIFIER_MODEL=
# 可选：前置分类器 max_tokens（允许范围 256..4096，默认 1024 以兼容带思考过程的兼容模型）
# FC_MODEL_CLASSIFIER_MAX_TOKENS=1024

# OpenDot 非店务营销对话模型与 live 分类器共用的 Anthropic Provider（按实际对接环境填写）
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=replace-with-provider-key
# ANTHROPIC_MODEL=replace-with-model-name
